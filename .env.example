# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION:
# Obtenha estas credenciais no painel do seu projeto Supabase (Project Settings > API)
# VITE_SUPABASE_URL: URL do projeto Supabase (ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# VITE_SUPABASE_ANON_KEY: Chave anónima pública (anon / public key)
VITE_SUPABASE_ANON_KEY=

# OPTIONAL DIRECT GATEWAYS (WHATSAPP & RESEND EMAIL):
# Se pretender pré-configurar a nível de ambiente (ex: Vercel Environment Variables)
VITE_WHATSAPP_GATEWAY_URL=
VITE_WHATSAPP_API_TOKEN=
VITE_RESEND_API_KEY=

